# Copy to .env and adjust. .env is gitignored; this file is committed.
# Every variable is prefixed TK_ and read exactly once, in app/settings.py.

# --- runtime ---------------------------------------------------------------
TK_ENV=local
TK_DEBUG=false
TK_LOG_LEVEL=INFO
TK_LOG_FORMAT=console          # json in containers, console when running locally

# --- stores ----------------------------------------------------------------
# Inside docker compose the hosts are `db` and `redis`; from your shell, localhost.
TK_DATABASE_URL=postgresql://threadkeeper:dev@localhost:5433/threadkeeper
TK_REDIS_URL=redis://localhost:6379/0

TK_DB_POOL_MIN=1
TK_DB_POOL_MAX=10

# --- channel: WhatsApp -----------------------------------------------------
# Set locally too, so signature verification is genuinely exercised in dev
# rather than skipped. Leave blank and the webhook accepts unsigned payloads —
# which settings.py refuses to allow outside local/test.
TK_WHATSAPP_APP_SECRET=local-dev-app-secret
TK_WHATSAPP_VERIFY_TOKEN=threadkeeper-dev-verify

# Only needed if TK_OUTBOUND_TRANSPORT=whatsapp, which this project never uses.
# TK_WHATSAPP_PHONE_NUMBER_ID=
# TK_WHATSAPP_ACCESS_TOKEN=

# --- outbound --------------------------------------------------------------
TK_OUTBOUND_TRANSPORT=mock     # mock | whatsapp
TK_OUTBOUND_MAX_ATTEMPTS=4
# Fraction of mock sends that fail transiently. Turn up to watch retries work.
TK_OUTBOUND_FAILURE_RATE=0.0

# --- privacy ---------------------------------------------------------------
# Fernet key for the PII vault: 32 bytes, base64url. Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes every existing token undecryptable — treat it as schema.
TK_VAULT_KEY=dGhyZWFka2VlcGVyLWxvY2FsLWRldi12YXVsdC1rZXk=
TK_TOKENIZE_INBOUND=true
# HMAC key deriving customer_ref from a phone number. Must be set outside local.
TK_CUSTOMER_REF_SECRET=dev-only-customer-ref-secret

# --- local tooling ---------------------------------------------------------
TK_ENABLE_SIMULATOR=true       # mounts /sim; forced off outside local/test

# --- model -----------------------------------------------------------------
# 'fake' is deterministic and offline: the test suite never spends money and a
# demo still works without a key. Switch to 'gemini' for real replies.
TK_LLM_PROVIDER=fake
# TK_GEMINI_API_KEY=
TK_GEMINI_REPLY_MODEL=gemini-3.5-flash-lite
TK_GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
TK_LLM_TIMEOUT_S=20
TK_LLM_MAX_ATTEMPTS=3

# --- lender tools ----------------------------------------------------------
TK_LENDER_LATENCY_MS=0        # simulated lender latency
TK_LENDER_FAILURE_RATE=0.05   # ~5% of lender calls fail, on purpose

# --- memory ----------------------------------------------------------------
TK_WORKING_BUDGET_TOKENS=1200   # tier 1: token budget, not a message count
TK_ENABLE_SEMANTIC_MEMORY=true  # tier 3: pgvector over conversation summaries
TK_RECALL_TOP_K=2
TK_EMBEDDING_MODEL=gemini-embedding-2
# Changing dimensions requires a migration — the column is vector(768).
TK_EMBEDDING_DIMENSIONS=768

# --- funnel ----------------------------------------------------------------
TK_HISTORY_TURNS=10             # hard cap on messages considered before trimming
