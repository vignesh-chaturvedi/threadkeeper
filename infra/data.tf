# RDS Postgres, ElastiCache Redis, and the secrets that address them.

resource "random_password" "db" {
  length = 32
  # RDS rejects '/', '@', '"' and space in a master password, and a password
  # that has to be URL-encoded into a DSN is a password that will eventually be
  # encoded wrong by something.
  special          = true
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

resource "aws_db_subnet_group" "main" {
  name       = local.name
  subnet_ids = aws_subnet.public[*].id
}

resource "aws_db_parameter_group" "main" {
  name   = "${local.name}-pg16"
  family = "postgres16"

  # pgvector is an extension the schema depends on; the baseline migration
  # creates it. Allow-listing it here means `CREATE EXTENSION vector` works
  # without a superuser, which the RDS master user is not.
  parameter {
    name         = "shared_preload_libraries"
    value        = "pg_stat_statements"
    apply_method = "pending-reboot"
  }
}

resource "aws_db_instance" "main" {
  identifier     = local.name
  engine         = "postgres"
  engine_version = "16"
  instance_class = var.db_instance_class

  allocated_storage     = 20
  max_allocated_storage = 50
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = "threadkeeper"
  username = "threadkeeper"
  password = random_password.db.result

  db_subnet_group_name   = aws_db_subnet_group.main.name
  parameter_group_name   = aws_db_parameter_group.main.name
  vpc_security_group_ids = [aws_security_group.data.id]
  publicly_accessible    = false

  # Single-AZ, no final snapshot, one day of backups. This is a demo with zero
  # real customer data and the bill should say so. Every one of these is the
  # wrong setting for anything real, which is why they are together and
  # commented rather than scattered.
  multi_az                = false
  skip_final_snapshot     = true
  backup_retention_period = 1
  deletion_protection     = false
  apply_immediately       = true
}

resource "aws_elasticache_subnet_group" "main" {
  name       = local.name
  subnet_ids = aws_subnet.public[*].id
}

resource "aws_elasticache_cluster" "main" {
  cluster_id           = local.name
  engine               = "redis"
  engine_version       = "7.1"
  node_type            = var.cache_node_type
  num_cache_nodes      = 1
  parameter_group_name = "default.redis7"
  port                 = 6379

  subnet_group_name  = aws_elasticache_subnet_group.main.name
  security_group_ids = [aws_security_group.data.id]

  # Redis here is a cache and a timer wheel, not a record. Every pending
  # follow-up is also a Postgres row and `queue.reconcile()` rebuilds the ZSET
  # from them — there is a test that flushes Redis mid-flight and asserts the
  # nudge still arrives. So losing this node loses no work, and paying for
  # replication would be paying to protect a derived index.
  snapshot_retention_limit = 0
}

# ------------------------------------------------------------------- secrets
#
# Three secrets, not one blob. A task that only needs the vault key should not
# be handed the database password to get it, and rotating one should not rewrite
# the others.

resource "aws_secretsmanager_secret" "database_url" {
  name                    = "${local.name}/database-url"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "database_url" {
  secret_id = aws_secretsmanager_secret.database_url.id
  secret_string = format(
    "postgresql://%s:%s@%s/%s",
    aws_db_instance.main.username,
    urlencode(random_password.db.result),
    aws_db_instance.main.endpoint,
    aws_db_instance.main.db_name,
  )
}

# The three application secrets Settings refuses to start without outside
# local/test — see the _refuse_unsafe_production_config validator. Terraform
# creates the containers; it does not invent the values, because a Fernet key or
# a BSP app secret generated by `random_password` would be a key nobody can
# rotate in step with the thing that trusts it.
resource "aws_secretsmanager_secret" "vault_key" {
  name                    = "${local.name}/vault-key"
  recovery_window_in_days = 0
  description             = "Fernet key for the PII vault. Rotating it makes every existing token undecryptable — see app/privacy/vault.py."
}

resource "aws_secretsmanager_secret" "customer_ref_secret" {
  name                    = "${local.name}/customer-ref-secret"
  recovery_window_in_days = 0
  description             = "HMAC key deriving customer_ref from a phone number. Rotating it orphans every existing conversation."
}

resource "aws_secretsmanager_secret" "whatsapp_app_secret" {
  name                    = "${local.name}/whatsapp-app-secret"
  recovery_window_in_days = 0
  description             = "BSP app secret for X-Hub-Signature-256 verification."
}

resource "aws_secretsmanager_secret" "gemini_api_key" {
  name                    = "${local.name}/gemini-api-key"
  recovery_window_in_days = 0
}
